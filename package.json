{
  "name": "neighbor-dev",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "data": "node scripts/build-data.mjs",
    "data:verify": "node scripts/verify-disclosure.mjs",
    "test": "pnpm --filter @neighbor/api test && pnpm --filter @neighbor/web test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm fsd:verify && pnpm room:verify && pnpm data && pnpm data:verify",
    "fsd:verify": "node scripts/verify-fsd.mjs",
    "room:verify": "node scripts/verify-room.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}
