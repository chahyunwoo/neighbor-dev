# 🔴 이 저장소는 PUBLIC 이다. 이 파일에 실값을 넣지 않는다.
#    (다른 프로젝트에서 client secret 이 .env.example 에 평문으로 커밋된 실례가 있다.)
#    값은 각자 .env.local 에 넣고, 그 파일은 .gitignore 에 걸려 있다.

# --- apps/api ---
# 포트: 이 맥은 여러 프로젝트가 포트를 나눠 쓴다. 띄우기 전에 매번 센다.
#   실측 2026-09-16: 3100·3101 을 다른 저장소의 dev 서버가 쥐고 있어 3201 로 비켰다.
API_PORT=3201

# AI 자가진단 (기획서 5절). 모델·상한은 기획서가 정한다.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# 남용 방지 2단 — IP 시간당 / 사이트 일일 총량. 일일 캡이 비용 방어의 본체다.
AI_RATE_LIMIT_PER_IP_HOUR=
AI_DAILY_TOTAL_CAP=

# --- 문의 접수 (apps/api) ---
# 🔴 저장하지 않는다. 받아서 메일로 넘기고 끝낸다.
CONTACT_TO=
CONTACT_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# 문의는 모델을 안 부르므로 비용이 아니라 스팸이 문제다. 넉넉히 두되 상한은 둔다.
CONTACT_DAILY_CAP=
CONTACT_RATE_LIMIT_PER_IP_HOUR=
# 🔴 로컬 검증용. 켜면 메일이 실제로 나가지 않는다 —
#    운영에서 켜지면 문의가 조용히 사라진다.
CONTACT_DRY_RUN=false

# --- DB ---
# 🔴 DB 를 두지 않는다. 프로젝트 데이터는 빌드 타임 정적 생성이고(`pnpm data`),
#    문의는 받아서 메일로 넘기고 끝낸다. 자가진단도 저장하지 않는다.
#    근거: `배포.md` — "DB 가 없으므로 마이그레이션 되돌리기가 없다".
#    실측: apps/api 에 DB 드라이버가 없다(prisma·typeorm·pg 0건).

# --- apps/web ---
WEB_PORT=3200
# 🔴 NEXT_PUBLIC_ 을 붙이지 않는다. 붙이면 api 주소가 브라우저 번들에 박힌다.
#    방문자 요청은 app/api/diagnose/route.ts 프록시를 거친다.
# 비워 두면 코드 기본값(http://localhost:3201)을 쓴다 — 로컬은 이대로 두면 된다.
API_BASE_URL=
